generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum ExpenseCategory {
  GasolinaDiesel
  Hotel
  Herramientas
  Material
  Other
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique
  password  String
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  projects     Project[]
  expenses     Expense[]
  files        File[]
  timeReports  TimeReport[]

  @@map("users")
}

model File {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  fileName           String   @map("file_name")
  cloud_storage_path String   @unique @map("cloud_storage_path")
  isPublic           Boolean  @default(false) @map("is_public")
  contentType        String   @map("content_type")
  fileSize           Int?     @map("file_size")
  createdAt          DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([userId])
  @@map("files")
}

model Project {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  projectNumber String   @map("project_number")
  name          String
  date          DateTime
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, projectNumber])
  @@index([userId])
  @@map("projects")
}

model Expense {
  id            String          @id @default(uuid()) @db.Uuid
  projectId     String          @map("project_id") @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  employeeName  String          @map("employee_name")
  date          DateTime
  category       ExpenseCategory
  customCategory String?         @map("custom_category")
  amount         Decimal         @db.Decimal(10, 2)
  receiptFileId String?         @map("receipt_file_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiptFile File?   @relation(fields: [receiptFileId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@index([receiptFileId])
  @@map("expenses")
}

model TimeReport {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  weekStart   DateTime    @map("week_start")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  employees   TimeEmployee[]

  @@index([userId])
  @@map("time_reports")
}

model TimeEmployee {
  id           String     @id @default(uuid()) @db.Uuid
  timeReportId String     @map("time_report_id") @db.Uuid
  name         String
  employeeId   String?    @map("employee_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  timeReport   TimeReport @relation(fields: [timeReportId], references: [id], onDelete: Cascade)
  days         TimeDay[]

  @@index([timeReportId])
  @@map("time_employees")
}

model TimeDay {
  id             String      @id @default(uuid()) @db.Uuid
  timeEmployeeId String      @map("time_employee_id") @db.Uuid
  dayName        String      @map("day_name")
  date           DateTime
  perDiem        Boolean     @default(false) @map("per_diem")

  timeEmployee   TimeEmployee @relation(fields: [timeEmployeeId], references: [id], onDelete: Cascade)
  shifts         TimeShift[]

  @@index([timeEmployeeId])
  @@map("time_days")
}

model TimeShift {
  id         String   @id @default(uuid()) @db.Uuid
  timeDayId  String   @map("time_day_id") @db.Uuid
  projectId  String?  @map("project_id")
  timeIn     Int?     @map("time_in")
  timeOut    Int?     @map("time_out")
  shiftNum   Int      @default(1) @map("shift_num")

  timeDay    TimeDay  @relation(fields: [timeDayId], references: [id], onDelete: Cascade)

  @@index([timeDayId])
  @@map("time_shifts")
}
